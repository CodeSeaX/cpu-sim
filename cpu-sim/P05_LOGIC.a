; Practical 5 : AND, OR, NOT, XOR, NOR, NAND on A and B
; Outputs in order: AND, OR, NOT A, NOT B, XOR, NOR, NAND
        INP
        STA A
        INP
        STA B
; ---- AND = A . B ----
        LDA A
        AND B
        STA RAND
        OUT             ; output 1 : A AND B
; ---- OR = (A' . B')' ----
        LDA B
        CMA
        STA NB          ; NB <- B'
        LDA A
        CMA
        STA NA          ; NA <- A'
        AND NB          ; A' . B'
        CMA             ; A + B
        STA ROR
        OUT             ; output 2 : A OR B
; ---- NOT A, NOT B ----
        LDA NA
        OUT             ; output 3 : NOT A
        LDA NB
        OUT             ; output 4 : NOT B
; ---- XOR = (A + B) . (A . B)' ----
        LDA RAND
        CMA             ; NAND
        STA RNAND
        AND ROR
        STA RXOR
        OUT             ; output 5 : A XOR B
; ---- NOR = (A + B)' ----
        LDA ROR
        CMA
        STA RNOR
        OUT             ; output 6 : A NOR B
; ---- NAND = (A . B)' ----
        LDA RNAND
        OUT             ; output 7 : A NAND B
        HLT
A:      .data 1 0
B:      .data 1 0
NA:     .data 1 0
NB:     .data 1 0
RAND:   .data 1 0
ROR:    .data 1 0
RXOR:   .data 1 0
RNOR:   .data 1 0
RNAND:  .data 1 0