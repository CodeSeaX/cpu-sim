; Practical 7 : Register-reference instructions CLA, CMA, CME, HLT
; Observe AC, E, PC, AR and IR (Decimal) after every instruction.
        LDA NUM     ; set-up: AC <- 25 so that CLA has something to clear
        CLA         ; 7800 : AC <- 0
        CMA         ; 7200 : AC <- AC' (0000 -> FFFF = -1)
        CME         ; 7100 : E <- E' (0 -> 1)
        HLT         ; 7001 : S <- 1 (halt)
NUM:    .data 1 25

