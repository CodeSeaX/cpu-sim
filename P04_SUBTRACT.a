; Practical 4 : SUBTRACT operation on two user-entered numbers
; Logic : DIFF = A - B = A + (2's complement of B)
        INP         ; AC <- A (minuend)
        STA A       ; M[A] <- AC
        INP         ; AC <- B (subtrahend)
        CMA         ; AC <- AC' (1's complement of B)
        INC         ; AC <- AC + 1 (2's complement, -B)
        ADD A       ; AC <- A + (-B) = A - B
        STA DIFF    ; M[DIFF] <- AC
        OUT         ; display the difference
        HLT
A:      .data 1 0   ; minuend
DIFF:   .data 1 0   ; result